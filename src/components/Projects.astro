---
import { projects } from '../data/site';
---
<section id="projects" class="border-y border-line bg-white">
  <div class="mx-auto max-w-6xl px-5 py-20">
    <h2 class="section-title">Projects</h2>
    <div class="mt-8 flex flex-col gap-6">
      {projects.map((p, i) => (
        <article class={`flex flex-col overflow-hidden border border-line bg-paper transition hover:border-accent-400 hover:shadow-lg hover:shadow-accent-100 md:min-h-72 ${i % 2 ? 'md:flex-row-reverse' : 'md:flex-row'}`}>
          <div class="relative aspect-[16/10] bg-ink md:aspect-auto md:grow-0 md:basis-[48%]">
            {p.images.length > 0 ? (
              <div class={`grid h-full gap-px bg-ink ${p.images.length > 1 ? 'grid-cols-2' : ''}`}>
                {p.images.map((img) => (
                  <img src={img.src} alt={img.alt} loading="lazy" class="h-full w-full object-cover" />
                ))}
              </div>
            ) : (
              <div class="flex h-full min-h-48 flex-col justify-between bg-gradient-to-br from-accent-50 to-accent-200 p-6" aria-hidden="true">
                <span class="font-mono text-xs uppercase tracking-wider text-accent-700">No preview available</span>
                <span class="font-mono text-6xl font-medium text-accent-700/70">{p.tags[0]}</span>
              </div>
            )}
          </div>
          <div class="flex min-w-0 flex-1 flex-col p-6 md:p-8">
            <h3 class="font-display text-2xl font-semibold">{p.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-muted">{p.summary}</p>
            <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1 border-t border-line pt-4 font-mono text-xs text-ink">
              {p.metrics.map((m) => <li>{m}</li>)}
            </ul>
            <ul class="mt-4 flex flex-wrap gap-2">
              {p.tags.map((t) => <li class="chip">{t}</li>)}
            </ul>
            <div class="mt-5 flex flex-wrap gap-3">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-accent-700 underline-offset-4 hover:underline">{l.label} →</a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
