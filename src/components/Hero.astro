---
import { site } from '../data/site';
---
<section id="top" class="border-b border-line bg-white">
  <div class="mx-auto max-w-6xl px-5 pb-12 pt-20 sm:pt-28">
    <h1 class="max-w-3xl font-display text-5xl font-bold leading-[1.05] tracking-tight sm:text-7xl">
      {site.fullName}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{site.tagline}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="#projects" class="btn-primary">View projects</a>
    </div>
  </div>
</section>
