---
import { experience } from '../data/site';
---
<section id="experience" class="mx-auto max-w-6xl px-5 py-20">
  <h2 class="section-title">Experience</h2>
  <ol class="mt-10 space-y-12 border-l border-accent-200 pl-8">
    {experience.map((org) => (
      <li class="relative">
        <span class="absolute -left-[2.6rem] top-1.5 h-3 w-3 border-2 border-accent-600 bg-paper" aria-hidden="true"></span>
        {org.roles.length > 1 ? (
          <>
            <div class="flex flex-wrap items-start justify-between gap-x-4">
              <h3 class="font-display text-xl font-semibold">{org.company}</h3>
              <div class="text-right">
                <p class="font-mono text-xs text-muted">{org.period}</p>
                <p class="font-mono text-xs text-muted">{org.location}</p>
              </div>
            </div>
            <ol class="mt-5 space-y-6 border-l border-line pl-6">
              {org.roles.map((r) => (
                <li class="relative">
                  <span class="absolute -left-[1.9rem] top-2 h-2 w-2 bg-accent-400" aria-hidden="true"></span>
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                    <h4 class="font-display text-lg font-semibold">{r.title}</h4>
                    <span class="font-mono text-xs text-muted">{r.period}</span>
                  </div>
                  <ul class="mt-2 list-disc space-y-1.5 pl-5 leading-relaxed text-muted marker:text-accent-400">
                    {r.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                </li>
              ))}
            </ol>
          </>
        ) : (
          <>
            <div class="flex flex-wrap items-start justify-between gap-x-4">
              <div>
                <h3 class="font-display text-xl font-semibold">{org.roles[0].title}</h3>
                <p class="text-sm text-accent-700">{org.company}</p>
              </div>
              <div class="text-right">
                <p class="font-mono text-xs text-muted">{org.roles[0].period}</p>
                <p class="font-mono text-xs text-muted">{org.location}</p>
              </div>
            </div>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 leading-relaxed text-muted marker:text-accent-400">
              {org.roles[0].points.map((pt) => <li>{pt}</li>)}
            </ul>
          </>
        )}
      </li>
    ))}
  </ol>
</section>
