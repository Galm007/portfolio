---
import { site } from '../data/site';
const nav = [
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
];
---
<header class="lg:hidden sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="#top" class="font-display text-lg font-semibold tracking-tight">
      {site.name}<span class="text-accent-600">.</span>
    </a>
    <nav aria-label="Primary" class="hidden gap-8 text-sm text-muted md:flex">
      {nav.map((n) => <a href={n.href} class="transition hover:text-accent-700">{n.label}</a>)}
    </nav>
    <a href={site.resume} class="btn-ghost hidden !py-1.5 md:inline-flex">Résumé</a>
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none border border-line bg-white px-3 py-1.5 text-sm">Menu</summary>
      <div class="absolute right-0 mt-2 flex w-44 flex-col border border-line bg-white p-2 text-sm shadow-lg">
        {nav.map((n) => <a href={n.href} class=" px-3 py-2 hover:bg-accent-50 hover:text-accent-700">{n.label}</a>)}
        <a href={site.resume} class=" px-3 py-2 hover:bg-accent-50 hover:text-accent-700">Résumé</a>
      </div>
    </details>
  </div>
</header>
