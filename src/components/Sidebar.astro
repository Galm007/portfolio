---
import { site } from '../data/site';
const nav = [
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
];
const links = [
  { href: site.links.github, label: 'Galm007', site: 'GitHub', viewBox: '0 0 16 16', path: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z' },
  { href: site.links.linkedin, label: 'jmar-pineda', site: 'LinkedIn', viewBox: '0 0 24 24', path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
];
---
<aside class="border-b border-line bg-white lg:fixed lg:inset-y-0 lg:left-0 lg:z-40 lg:w-80 lg:overflow-y-auto lg:border-b-0 lg:border-r" aria-label="Profile">
  <div class="flex flex-col gap-8 p-8 lg:min-h-full lg:justify-between">
    <div class="text-center">
      <img
        src={site.photo}
        alt={`Portrait of ${site.name}`}
        width="256"
        height="256"
        class="mx-auto h-48 w-48 border border-line object-cover lg:h-64 lg:w-64"
      />
      <h2 class="mt-6 font-display text-2xl font-semibold tracking-tight">{site.name}</h2>
      <p class="mt-1 text-sm text-accent-700">{site.title}, NYIT</p>

      <div class="-mx-8 mt-6 space-y-4 border-y border-black px-8 py-5 text-sm">
        <ul class="space-y-2 text-muted">
          <li><a href={`mailto:${site.email}`} class="transition hover:text-accent-700">{site.email}</a></li>
          <li><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="transition hover:text-accent-700">{site.phone}</a></li>
          <li>{site.location}</li>
        </ul>
        <ul class="space-y-2 text-muted">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${l.site}: ${l.label}`}
                class="inline-flex items-center gap-2 text-accent-700 underline underline-offset-4 transition hover:text-accent-900"
              >
                {l.label}
                <svg viewBox={l.viewBox} class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true"><path d={l.path} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav aria-label="Primary" class="mt-4 hidden flex-col gap-1 text-sm lg:flex">
        {nav.map((n) => (
          <a href={n.href} data-nav class="border-2 border-transparent px-3 py-2 text-center text-muted hover:bg-accent-50 hover:text-accent-700 aria-[current=true]:border-accent-700 aria-[current=true]:bg-accent-50 aria-[current=true]:text-accent-700">{n.label}</a>
        ))}
      </nav>
    </div>

    <a href={site.resume} class="btn-primary w-full justify-center text-sm shadow-lg shadow-black/25">Download résumé</a>
  </div>
</aside>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav]'));
  const targets = links
    .map((a) => ({ a, el: document.querySelector<HTMLElement>(a.getAttribute('href')!) }))
    .filter((t): t is { a: HTMLAnchorElement; el: HTMLElement } => t.el !== null);

  function update() {
    const line = window.innerHeight * 0.35;
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    let current: HTMLAnchorElement | null = null;
    for (const t of targets) {
      if (t.el.getBoundingClientRect().top <= line) current = t.a;
    }
    if (atBottom && targets.length) current = targets[targets.length - 1].a;
    for (const a of links) a.setAttribute('aria-current', String(a === current));
  }

  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
</script>
